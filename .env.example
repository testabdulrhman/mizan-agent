# ==========================================================================
# Mizan Agent — نموذج متغيرات البيئة
# انسخ هذا الملف إلى .env ثم املأ القيم. لا ترفع .env إلى git أبداً.
# ==========================================================================

# --- قاعدة البيانات (PostgreSQL) ---
# مع docker-compose المرفق استخدم القيمة التالية كما هي:
DATABASE_URL="postgresql://mizan:mizan_dev_password@localhost:5432/mizan?schema=public"

# --- الجلسات ---
# مفتاح توقيع الجلسات. ولّد واحداً بـ: openssl rand -base64 48
AUTH_SECRET="ضع-هنا-مفتاحاً-عشوائياً-طوله-32-حرفاً-على-الأقل"
# مدة صلاحية الجلسة بالأيام
SESSION_TTL_DAYS="7"

# --- مزوّد الذكاء الاصطناعي (يُستخدم من الخادم فقط) ---
# LLM_PROVIDER = anthropic | openai | mock
# mock = ردود محلية بدون مفتاح، مفيدة للتجربة والاختبارات.
LLM_PROVIDER="anthropic"

# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# OpenAI (بديل اختياري)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"
OPENAI_BASE_URL="https://api.openai.com/v1"

# --- قارئ الروابط ---
WEB_READ_TIMEOUT_MS="12000"
WEB_READ_MAX_BYTES="2500000"
# تفعيل Playwright للصفحات التي تعتمد على JavaScript.
# يتطلب: npm install playwright && npx playwright install chromium
PLAYWRIGHT_ENABLED="false"
# قائمة نطاقات محظورة إضافية، مفصولة بفواصل (اختياري)
WEB_READ_BLOCKED_HOSTS=""

# --- الملفات ---
MAX_UPLOAD_BYTES="10485760"
# مجلد تخزين الملفات المحفوظة اختيارياً من المستخدم
FILE_STORAGE_DIR=".data/uploads"
# مدة الاحتفاظ بالملفات المحفوظة (بالأيام) قبل اعتبارها منتهية
FILE_RETENTION_DAYS="30"

# --- Sandbox تشغيل الكود ---
# لا يعمل التشغيل إطلاقاً إن كان false. لا يوجد تنفيذ على الخادم الأساسي بأي حال.
SANDBOX_ENABLED="false"
SANDBOX_IMAGE="mizan-sandbox-node:1"
SANDBOX_TIMEOUT_MS="15000"
SANDBOX_MEMORY_MB="256"
SANDBOX_CPUS="0.5"
SANDBOX_PIDS_LIMIT="128"
SANDBOX_MAX_OUTPUT_BYTES="200000"
SANDBOX_MAX_PROJECT_BYTES="2097152"
# اسم أمر Docker (docker أو podman)
SANDBOX_DOCKER_BIN="docker"

# --- عام ---
NEXT_PUBLIC_APP_NAME="Mizan Agent"
NODE_ENV="development"
