// Mizan Agent — مخطط قاعدة البيانات
// PostgreSQL + Prisma. كل بيانات المستخدم معزولة بـ userId ويُتحقق منها في كل استعلام.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conversations Conversation[]
  projects      Project[]
  approvals     Approval[]

  @@map("users")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("محادثة جديدة")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
  attachments Attachment[]
  projects    Project[]
  approvals   Approval[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

enum MessageRole {
  user
  assistant
  system
  tool
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  // metadata: نوع التوجيه، الأدوات المستخدمة، المصادر، الملفات الناتجة ...
  metadata       Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Attachment {
  id             String   @id @default(cuid())
  conversationId String
  filename       String
  mimeType       String
  size           Int
  // storageKey فارغ = لم يُحفظ الملف على القرص (وضع التحليل المؤقت الافتراضي)
  storageKey     String?
  persisted      Boolean  @default(false)
  textPreview    String?  @db.Text
  createdAt      DateTime @default(now())
  expiresAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("attachments")
}

model Project {
  id             String   @id @default(cuid())
  userId         String
  conversationId String?
  name           String
  description    String?  @db.Text
  runtime        String   @default("node")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  files        ProjectFile[]
  executions   Execution[]

  @@index([userId, updatedAt])
  @@map("projects")
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  path      String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@map("project_files")
}

enum ExecutionStatus {
  pending
  running
  succeeded
  failed
  timeout
  rejected
}

model Execution {
  id         String          @id @default(cuid())
  projectId  String
  status     ExecutionStatus @default(pending)
  command    String
  output     String?         @db.Text
  error      String?         @db.Text
  exitCode   Int?
  durationMs Int?
  sandbox    String?
  startedAt  DateTime        @default(now())
  finishedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, startedAt])
  @@map("executions")
}

enum ApprovalStatus {
  pending
  approved
  rejected
  expired
}

// سجل الموافقات: كل عملية مؤثرة تُسجَّل هنا قبل التنفيذ وبعده.
model Approval {
  id             String         @id @default(cuid())
  userId         String
  conversationId String?
  action         String
  summary        String         @db.Text
  details        Json?
  status         ApprovalStatus @default(pending)
  createdAt      DateTime       @default(now())
  decidedAt      DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("approvals")
}
